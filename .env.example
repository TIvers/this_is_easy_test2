KEITARO_URL=https://your-keitaro-host.example
KEITARO_API_KEY=
DATABASE_URL=sqlite:///./adrobot.db

# Optional defaults; when unset, select these values in the campaign form.
DEFAULT_DOMAIN_ID=
DEFAULT_GROUP_ID=
DEFAULT_SOURCE_ID=

REDIRECT_URL=https://www.google.com

# Single administrator account. Generate a hash with: python -m app.password_hash
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
SESSION_SECRET_KEY=
SESSION_COOKIE_SECURE=false
