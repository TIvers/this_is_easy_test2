[Unit]
Description=Adrobot FastAPI application
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=adrobot
Group=adrobot
WorkingDirectory=/opt/adrobot
EnvironmentFile=/etc/adrobot/adrobot.env
Environment=PYTHONUNBUFFERED=1
UMask=0077
ExecStartPre=/opt/adrobot/.venv/bin/python -m alembic upgrade head
ExecStart=/opt/adrobot/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=5
TimeoutStartSec=120
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/adrobot

[Install]
WantedBy=multi-user.target
